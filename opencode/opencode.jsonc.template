{
  "$schema": "https:\/\/opencode.ai\/config.json",
  "model": "",
  "default_agent": "gandalf",
  "share": "disabled",
  "instructions": [
    "instruction/repo-context.md",
    "instruction/agent-defaults.md",
    "instruction/update-awareness.md"
  ],
  "plugin": [
    "@tarquinen/opencode-dcp@3.1.12",
    ["@skwid138/opencode-council@0.10.0", {"council": {"reviewer": "saruman", "models": []}}]
  ],
  "permission": {
    "external_directory": {
      "*": "ask",
      "$AI_BOOTSTRAP_WORKSPACE/*": "allow",
      "$HOME/.config/opencode/*": "allow",
      "$HOME/.nvm/*": "allow",
      "$HOME/.cache/*": "allow",
      "$HOME/.local/*": "allow",
      "/opt/homebrew/*": "allow",
      "/tmp/*": "allow"
    },
    "edit": { "*": "ask" },
    "write": { "*": "ask" },
    "question": "deny",
    "bash": {
      "*": "ask",
      "$AI_BOOTSTRAP_WORKSPACE/scripts/agent/bootstrap-update-check.sh *": "allow",
      "$AI_BOOTSTRAP_WORKSPACE/scripts/agent/opencode-deps-check.sh *": "allow",
      "$AI_BOOTSTRAP_WORKSPACE/scripts/agent/permission-audit.sh *": "allow",
      "$AI_BOOTSTRAP_WORKSPACE/scripts/agent/set-models.sh *": "allow",
      "$AI_BOOTSTRAP_WORKSPACE/scripts/agent/chrome_mcp.sh *": "allow",
      "$OPENCODE_CONFIG_DIR/skill/handoff/redact-secrets.sh *": "allow",
      "basename *": "allow",
      "bats *": "allow",
      "brew --prefix*": "allow",
      "brew list*": "allow",
      "cat *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "echo *": "allow",
      "fd *": "allow",
      "file *": "allow",
      "find *": "allow",
      "gh search *": "allow",
      "git blame*": "allow",
      "git branch*": "allow",
      "git diff*": "allow",
      "git grep*": "allow",
      "git log*": "allow",
      "git ls-files*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "npm info*": "allow",
      "opencode --version": "allow",
      "printenv*": "allow",
      "printf *": "allow",
      "pwd": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "rg *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "strings *": "allow",
      "tail *": "allow",
      "true": "allow",
      "wc *": "allow",
      "which *": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git push -f*": "deny",
      "git push * -f*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "rm *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "sudo *": "deny",
      "sed -i*": "deny",
      "sed -i *": "deny"
    }
  },
  "agent": {
    "plan": {
      "mode": "subagent",
      "hidden": true
    },
    "build": {
      "mode": "subagent",
      "hidden": true
    },
    "general": {
      "hidden": true
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@1.1.1", "--browserUrl", "http:\/\/127.0.0.1:9222"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https:\/\/mcp.context7.com\/mcp",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https:\/\/mcp.exa.ai\/mcp",
      "enabled": true
    }
  }
}
