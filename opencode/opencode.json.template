{
  "$schema": "https://opencode.ai/config.json",
  "model": "",
  "default_agent": "plan",
  "share": "disabled",
  "instructions": [
    "instruction/repo-context.md",
    "instruction/plan-workflow.md"
  ],
  "plugin": [
    "@tarquinen/opencode-dcp@3.1.9"
  ],
  "permission": {
    "edit": { "*": "ask" },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "cat *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        }
      }
    },
    "build": {
      "permission": {
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git push --force*": "deny",
          "git reset --hard*": "deny",
          "rm -rf *": "deny",
          "sudo *": "deny"
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@0.23.0", "--browserUrl", "http://127.0.0.1:9222"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    }
  }
}
