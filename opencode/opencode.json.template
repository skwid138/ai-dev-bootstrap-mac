{
  "$schema": "https://opencode.ai/config.json",
  "model": "",
  "default_agent": "gandalf",
  "share": "disabled",
  "instructions": [
    "instruction/repo-context.md",
    "instruction/agent-defaults.md",
    "instruction/update-awareness.md"
  ],
  "plugin": [
    "@tarquinen/opencode-dcp@3.1.11"
  ],
  "permission": {
    "edit": { "*": "ask" },
    "write": { "*": "ask" },
    "bash": {
      "*": "ask",
      "$AI_BOOTSTRAP_WORKSPACE/scripts/agent/bootstrap-update-check.sh *": "allow",
      "$AI_BOOTSTRAP_WORKSPACE/scripts/agent/opencode-deps-check.sh *": "allow",
      "$AI_BOOTSTRAP_WORKSPACE/scripts/agent/permission-audit.sh *": "allow",
      "bats *": "allow",
      "cat *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "echo *": "allow",
      "file *": "allow",
      "find *": "allow",
      "git blame*": "allow",
      "git branch*": "allow",
      "git diff*": "allow",
      "git grep*": "allow",
      "git log*": "allow",
      "git ls-files*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "printenv*": "allow",
      "printf *": "allow",
      "pwd": "allow",
      "readlink *": "allow",
      "rg *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "fd *": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git push -f*": "deny",
      "git push * -f*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "rm *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "sudo *": "deny"
    }
  },
  "agent": {
    "plan": {
      "mode": "subagent",
      "hidden": true
    },
    "build": {
      "mode": "subagent",
      "hidden": true
    },
    "general": {
      "hidden": true
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@0.23.0", "--browserUrl", "http://127.0.0.1:9222"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    }
  }
}
