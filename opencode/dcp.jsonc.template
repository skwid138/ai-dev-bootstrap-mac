// dcp (dynamic context pruning) plugin configuration.
//
// dcp is loaded by opencode via the `plugin: ["@tarquinen/opencode-dcp"]`
// entry in opencode.jsonc. It reads its own sibling config file
// (this one — dcp.jsonc) at one of these paths, in priority order:
//   1. ./.opencode/dcp.jsonc          (per-project)
//   2. $OPENCODE_CONFIG_DIR/dcp.jsonc (env override)
//   3. ~/.config/opencode/dcp.jsonc   (global — this file's install dest)
//
// Why this lives in its own file (not opencode.jsonc):
//   dcp ignores any `dcp` key inside opencode.jsonc. The plugin uses a
//   sibling file so its schema can evolve independently of opencode core.
//
// What this config does:
//   Enables dcp's automatic mode: slash commands stay available, automatic
//   deduplication / error purging run as a safety net, and range compression
//   nudges the agent once the conversation reaches 65% of the model's context
//   window. All context limits are percentages so the same template works
//   across providers with different window sizes.
//
// Tuning notes:
//   - Lower the percent (e.g. "55%") if you find auto-notes triggers too
//     late and you've been losing context fidelity by the time it fires.
//   - Raise it (e.g. "75%") if you find the nudges are interrupting
//     productive flow before context pressure is real.
//   - Number form (e.g. 65000) is also accepted but doesn't adapt to
//     model changes; prefer the percent string.
//
// Schema reference:
//   https://github.com/Opencode-DCP/opencode-dynamic-context-pruning
//   Verified against the plugin schema: compress.maxContextLimit and
//   compress.minContextLimit both accept number | "<N>%" string.
{
  "$schema": "https:\/\/raw.githubusercontent.com\/Opencode-DCP\/opencode-dynamic-context-pruning\/master\/dcp.schema.json",
  "enabled": true,
  "debug": false,
  "pruneNotification": "minimal",
  "pruneNotificationType": "chat",
  "commands": {
    "enabled": true,
    "protectedTools": [
      "task",
      "skill",
      "todowrite",
      "todoread"
    ]
  },
  "manualMode": {
    "enabled": false,
    "automaticStrategies": true
  },
  "turnProtection": {
    "enabled": false,
    "turns": 4
  },
  "experimental": {
    "allowSubAgents": false,
    "customPrompts": false
  },
  "protectedFilePatterns": [],
  "compress": {
    "mode": "range",
    "permission": "allow",
    "showCompression": true,
    "summaryBuffer": true,
    "maxContextLimit": "65%",
    "minContextLimit": "35%",
    "nudgeFrequency": 5,
    "iterationNudgeThreshold": 15,
    "nudgeForce": "soft",
    "protectedTools": [
      "task",
      "skill",
      "todowrite",
      "todoread"
    ],
    "protectUserMessages": false
  },
  "strategies": {
    "deduplication": {
      "enabled": true,
      "protectedTools": [
        "task",
        "skill",
        "todowrite",
        "todoread"
      ]
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 4,
      "protectedTools": [
        "task",
        "skill",
        "todowrite",
        "todoread"
      ]
    }
  }
}
